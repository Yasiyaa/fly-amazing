# Amazing World Travel: environment configuration
# Copy to .env.local for local development. Never commit real values.

# --- Supabase (catalogue, bookings, admin sign-in, media uploads) ---------------
# Without these the public site runs on the bundled catalogue in src/data/seed,
# bookings are emailed only, and the admin area is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for booking/enquiry inserts and chat logging. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI trip planner (Claude API) ------------------------------------------------
# Without a key the planner shows a friendly "contact us" message instead.
# Set a monthly spend limit for this key in the Anthropic Console.
ANTHROPIC_API_KEY=

# --- Email ------------------------------------------------------------------------
# Team inbox for new booking requests and enquiries.
ADMIN_NOTIFICATION_EMAIL=info@amazingworldtravel.com
# Optional SMTP. If unset, emails are logged instead of sent and requests still succeed.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=bookings@amazingworldtravel.com

# --- Misc -------------------------------------------------------------------------
# Salt for hashing visitor IPs before storing chat rate-limit data.
IP_HASH_SALT=change-me
# Protects /api/cron/fx (Vercel Cron sends it as a bearer token).
CRON_SECRET=
